<Window x:Class="MusikArchivApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MusikArchivApp.Converters"
        xmlns:loc="clr-namespace:MusikArchivApp.Localization"
        Title="Musikarchiv" Height="650" Width="1100">
    <Window.Resources>
        <SolidColorBrush x:Key="RequiredBackground" Color="#FFFFC0C0" />

        <!-- Filter-Operator-Konverter (Enum -> lokalisierter Text) -->
        <conv:FilterOperatorConverter x:Key="FilterOperatorConverter" />
        <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
        <conv:HexColorToForegroundBrushConverter x:Key="HexColorToForegroundBrushConverter" />

        <DataTemplate x:Key="CabinetCellTemplate">
            <Border Background="{Binding CabinetColor, Converter={StaticResource HexColorToBrushConverter}}"
                    Padding="6,2"
                    BorderBrush="#AAAAAA"
                    BorderThickness="1"
                    CornerRadius="2"
                    Margin="1">
                <TextBlock Text="{Binding Cabinet}"
                           Foreground="{Binding CabinetColor, Converter={StaticResource HexColorToForegroundBrushConverter}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
            </Border>
        </DataTemplate>

        <!-- Style für alle Operator-ComboBoxen im Filter-Reiter -->
        <Style x:Key="OperatorComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="110" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource FilterOperatorConverter}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RequiredTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Background" Value="{StaticResource RequiredBackground}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Marker-Style für Pflicht-Comboboxen; Farben werden im Code-Behind gesetzt -->
        <Style x:Key="RequiredComboBoxStyle" TargetType="ComboBox" />

        <Style x:Key="RequiredListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItems.Count, RelativeSource={RelativeSource Self}}" Value="0">
                    <Setter Property="Background" Value="{StaticResource RequiredBackground}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <Border x:Name="SyncWarningBanner"
                DockPanel.Dock="Top"
                Background="#FFF4CE"
                BorderBrush="#F5C542"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,0,0,8"
                Visibility="Collapsed">
            <TextBlock x:Name="SyncWarningText" TextWrapping="Wrap" Foreground="#7A5B00"/>
        </Border>

        <Border x:Name="UpdateBanner"
                DockPanel.Dock="Top"
                Background="#E7F6EC"
                BorderBrush="#2E7D32"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,0,0,8"
                Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="UpdateBannerButton"
                        DockPanel.Dock="Right"
                        Content="Aktualisieren"
                        Width="120"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Click="InstallUpdateButton_Click"/>
                <TextBlock x:Name="UpdateBannerText"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="#1B5E20"/>
            </DockPanel>
        </Border>

    <TabControl x:Name="MainTabControl">
        <!-- Editor-Reiter -->
        <TabItem Header="Editor">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{Binding EditorHeaderText}" FontSize="20" FontWeight="Bold" />
                </StackPanel>

                <!-- Editorbereich -->
                <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Name des Musikstücks" />
                        <TextBox Style="{StaticResource RequiredTextBoxStyle}"
                                 Text="{Binding CurrentPiece.Title, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Komponist" />
                        <TextBox Text="{Binding CurrentPiece.Composer}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Arrangeur" />
                        <TextBox Text="{Binding CurrentPiece.Arranger}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Verlag" />
                        <TextBox Text="{Binding CurrentPiece.Publisher}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="ISBN" />
                        <TextBox Text="{Binding CurrentPiece.Isbn}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Ablageort (automatisch)" />
                        <TextBox Text="{Binding CurrentPiece.FolderPath, Mode=OneWay}" IsReadOnly="True" Background="#F5F5F5" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Tags (Getrennt durch #)" />
                        <Border BorderBrush="#ABADB3" BorderThickness="1" CornerRadius="2">
                            <StackPanel>
                                <ListBox x:Name="TagsListBox"
                                         ItemsSource="{Binding AvailableTags}"
                                         SelectionMode="Multiple"
                                         Height="80"
                                         BorderThickness="0" />
                                <TextBox x:Name="InlineNewTagTextBox"
                                         Text="Neuen Tag hinzufügen …"
                                         Foreground="Gray"
                                         BorderThickness="0,1,0,0"
                                         BorderBrush="#DDDDDD"
                                         Padding="4,3"
                                         GotFocus="InlineNewTagTextBox_GotFocus"
                                         LostFocus="InlineNewTagTextBox_LostFocus"
                                         KeyDown="InlineNewTagTextBox_KeyDown" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <StackPanel Width="120" Margin="0,0,10,0">
                            <TextBlock Text="Schrank" />
                            <Border x:Name="CabinetBorder" BorderThickness="1" BorderBrush="Gray" CornerRadius="2">
                                <ComboBox x:Name="CabinetComboBox"
                                          Style="{StaticResource RequiredComboBoxStyle}"
                                          Loaded="RequiredComboBox_Loaded"
                                          SelectionChanged="RequiredComboBox_SelectionChanged"
                                          ItemsSource="{Binding AvailableCabinets}"
                                          SelectedValuePath="Name"
                                          SelectedValue="{Binding CurrentPiece.Cabinet, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" Background="{Binding DisplayBrush}" BorderBrush="Gray" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Border>
                        </StackPanel>
                        <StackPanel Width="120" Margin="0,0,10,0">
                            <TextBlock Text="Fach" />
                            <Border x:Name="CompartmentBorder" BorderThickness="1" BorderBrush="Gray" CornerRadius="2">
                                <ComboBox x:Name="CompartmentComboBox"
                                          Style="{StaticResource RequiredComboBoxStyle}"
                                          Loaded="RequiredComboBox_Loaded"
                                          SelectionChanged="RequiredComboBox_SelectionChanged"
                                          ItemsSource="{Binding AvailableCompartments}"
                                          SelectedItem="{Binding CurrentPiece.Compartment, Mode=TwoWay}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Width="120" Margin="0,0,10,0">
                            <TextBlock Text="Einschub" />
                            <Border x:Name="SlotBorder" BorderThickness="1" BorderBrush="Gray" CornerRadius="2">
                                <ComboBox x:Name="SlotComboBox"
                                          Style="{StaticResource RequiredComboBoxStyle}"
                                          Loaded="RequiredComboBox_Loaded"
                                          SelectionChanged="RequiredComboBox_SelectionChanged"
                                          ItemsSource="{Binding AvailableSlots}"
                                          SelectedItem="{Binding CurrentPiece.Slot, Mode=TwoWay}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Musikgattung" />
                        <ListBox x:Name="GenresListBox"
                                 Style="{StaticResource RequiredListBoxStyle}"
                                 ItemsSource="{Binding AvailableGenres}"
                                 SelectionMode="Multiple"
                                 Height="80" />
                    </StackPanel>

                    <CheckBox Content="Aktiv (im Probelokal) / Nicht aktiv (im Schrank)"
                              IsChecked="{Binding CurrentPiece.IsActive, Mode=TwoWay}"
                              Margin="0,10,0,0" />
                </StackPanel>
                </ScrollViewer>

                <!-- Besetzung in vier benannten Gruppen -->
                <GroupBox Grid.Row="1" Grid.Column="1" Header="Besetzung" Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Gruppe 1: Partitur/Direktion -->
                        <DockPanel Grid.Column="0" Margin="0,0,8,0">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Partitur/Direktion" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button Content="Alle/Keine" Padding="4,1" FontSize="10" Click="ToggleGroup1_Click" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding InstrumentsGroup1}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Instrument.Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Gruppe 2: Holz -->
                        <DockPanel Grid.Column="1" Margin="0,0,8,0">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Holz" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button Content="Alle/Keine" Padding="4,1" FontSize="10" Click="ToggleGroup2_Click" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding InstrumentsGroup2}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Instrument.Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Gruppe 3: Schlagwerk -->
                        <DockPanel Grid.Column="2" Margin="0,0,8,0">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Schlagwerk" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button Content="Alle/Keine" Padding="4,1" FontSize="10" Click="ToggleGroup3_Click" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding InstrumentsGroup3}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Instrument.Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Gruppe 4: Blechbläser / Gesang -->
                        <DockPanel Grid.Column="3">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Blechbläser" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button Content="Alle/Keine" Padding="4,1" FontSize="10" Click="ToggleGroup4_Click" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding InstrumentsGroup4}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Instrument.Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </GroupBox>

                <!-- Buttons für Editor -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Digitale Noten …" Width="140" Margin="0,0,10,0" Click="OpenCurrentSheetMusic_Click" />
                    <Button Content="Eingaben Löschen" Width="160" Margin="0,0,10,0" Command="{Binding NewCommand}" />
                    <Button Content="Speichern" Width="140" Margin="0,0,10,0" Command="{Binding SaveCommand}" />
                    <Button Content="Stück löschen" Width="140" Command="{Binding DeleteCommand}" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- Listen-Reiter -->
        <TabItem Header="Liste">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="⚙ Spalten konfigurieren …" Padding="10,4" Click="OpenColumnConfig_Click"/>
                        <Separator Margin="8,0" Width="1" Background="#DDDDDD"/>
                        <Button Content="⬆ Als JSON exportieren" Padding="10,4" Margin="8,0,0,0" Click="ExportListJson_Click"/>
                        <Button Content="⬆ Als CSV exportieren" Padding="10,4" Margin="8,0,0,0" Click="ExportListCsv_Click"/>
                        <Button Content="🖨 Liste drucken …" Padding="10,4" Margin="8,0,0,0" Click="PrintListButton_Click"/>
                        <Button Content="⬇ Aus JSON importieren" Padding="10,4" Margin="8,0,0,0" Click="ImportListJson_Click"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="PieceListGrid" Grid.Row="1"
                          ItemsSource="{Binding Pieces}" SelectedItem="{Binding SelectedPiece}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          MouseDoubleClick="PieceListGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColName"        Header="Name"             Binding="{Binding Title}"       Width="*"   MinWidth="120"/>
                        <DataGridTextColumn x:Name="ColComposer"    Header="Komponist"        Binding="{Binding Composer}"    Width="*"   MinWidth="80"/>
                        <DataGridTextColumn x:Name="ColArranger"    Header="Arrangeur"        Binding="{Binding Arranger}"    Width="*"   MinWidth="80"/>
                        <DataGridTextColumn x:Name="ColGenre"       Header="Gattung"          Binding="{Binding Genre}"       Width="*"   MinWidth="80"/>
                        <DataGridTextColumn x:Name="ColTags"        Header="Tags"             Binding="{Binding Tags}"        Width="*"   MinWidth="80"/>
                        <DataGridCheckBoxColumn x:Name="ColIsActive"    Header="Aktiv"        Binding="{Binding IsActive}"    Width="55"/>
                        <DataGridTemplateColumn x:Name="ColCabinet" Header="Schrank" Width="80" SortMemberPath="Cabinet" CanUserSort="True" CellTemplate="{StaticResource CabinetCellTemplate}" />
                        <DataGridTextColumn x:Name="ColCompartment" Header="Fach"             Binding="{Binding Compartment}" Width="60"/>
                        <DataGridTextColumn x:Name="ColSlot"        Header="Einschub"         Binding="{Binding Slot}"        Width="70"/>
                        <DataGridTextColumn x:Name="ColDigitalScores" Header="Noten" Binding="{Binding DigitalScoreCount}" Width="55"/>
                        <DataGridTextColumn x:Name="ColBesetzung"   Header="Besetzung"        Binding="{Binding Besetzung}"   Width="*"   MinWidth="80"  Visibility="Collapsed"/>
                        <DataGridTextColumn x:Name="ColPublisher"   Header="Verlag"           Binding="{Binding Publisher}"   Width="*"   MinWidth="80"  Visibility="Collapsed"/>
                        <DataGridTextColumn x:Name="ColIsbn"        Header="ISBN"             Binding="{Binding Isbn}"        Width="110"                Visibility="Collapsed"/>
                        <DataGridTextColumn x:Name="ColFolderPath"  Header="Ordnerpfad"       Binding="{Binding FolderPath}"  Width="*"   MinWidth="80"  Visibility="Collapsed"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Content="Aus Liste laden" Width="130" Margin="0,0,10,0" Command="{Binding LoadFromSelectionCommand}"/>
                    <Button Content="Stück löschen" Width="130" Command="{Binding DeleteFromListCommand}"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- Filter-Reiter -->
        <TabItem Header="Filter">
            <Grid Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Filterkriterien" FontWeight="Bold" Margin="0,0,0,8" />

                    <UniformGrid Rows="2" Columns="3" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Name" />
                            <DockPanel>
                                <ComboBox Style="{StaticResource OperatorComboBoxStyle}" DockPanel.Dock="Left"
                                          ItemsSource="{Binding FilterOperatorOptions}" SelectedItem="{Binding TitleFilterOperator}" />
                                <TextBox Text="{Binding TitleFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Komponist" />
                            <DockPanel>
                                <ComboBox Style="{StaticResource OperatorComboBoxStyle}" DockPanel.Dock="Left"
                                          ItemsSource="{Binding FilterOperatorOptions}" SelectedItem="{Binding ComposerFilterOperator}" />
                                <TextBox Text="{Binding ComposerFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Arrangeur" />
                            <DockPanel>
                                <ComboBox Style="{StaticResource OperatorComboBoxStyle}" DockPanel.Dock="Left"
                                          ItemsSource="{Binding FilterOperatorOptions}" SelectedItem="{Binding ArrangerFilterOperator}" />
                                <TextBox Text="{Binding ArrangerFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Verlag" />
                            <DockPanel>
                                <ComboBox Style="{StaticResource OperatorComboBoxStyle}" DockPanel.Dock="Left"
                                          ItemsSource="{Binding FilterOperatorOptions}" SelectedItem="{Binding PublisherFilterOperator}" />
                                <TextBox Text="{Binding PublisherFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="ISBN" />
                            <DockPanel>
                                <ComboBox Style="{StaticResource OperatorComboBoxStyle}" DockPanel.Dock="Left"
                                          ItemsSource="{Binding FilterOperatorOptions}" SelectedItem="{Binding IsbnFilterOperator}" />
                                <TextBox Text="{Binding IsbnFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Tags" />
                            <DockPanel>
                                <ComboBox Style="{StaticResource OperatorComboBoxStyle}" DockPanel.Dock="Left"
                                          ItemsSource="{Binding FilterOperatorOptions}" SelectedItem="{Binding TagsFilterOperator}" />
                                <TextBox Text="{Binding TagsFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <StackPanel Width="120" Margin="0,0,10,0">
                            <TextBlock Text="Schrank" />
                            <ComboBox ItemsSource="{Binding CabinetFilterOptions}" SelectedItem="{Binding CabinetFilter}" />
                        </StackPanel>
                        <StackPanel Width="120" Margin="0,0,10,0">
                            <TextBlock Text="Fach" />
                            <ComboBox ItemsSource="{Binding CompartmentFilterOptions}" SelectedItem="{Binding CompartmentFilter}" />
                        </StackPanel>
                        <StackPanel Width="120" Margin="0,0,10,0">
                            <TextBlock Text="Einschub" />
                            <ComboBox ItemsSource="{Binding SlotFilterOptions}" SelectedItem="{Binding SlotFilter}" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,10,0">
                            <TextBlock Text="Musikgattung" />
                            <ListBox x:Name="GenreFilterListBox"
                                     ItemsSource="{Binding AvailableGenres}"
                                     SelectionMode="Multiple"
                                     Height="80" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                            <CheckBox Content="Nur aktive" IsChecked="{Binding OnlyActiveFilter}" Margin="0,0,10,0" />
                            <CheckBox Content="Nur mit digitalen Noten" IsChecked="{Binding OnlyWithDigitalScoresFilter}" Margin="0,0,10,0" />
                            <Button Content="Filtern" Width="80" Command="{Binding FilterCommand}" Margin="0,0,8,0" />
                            <Button Content="Zurücksetzen" Width="100" Command="{Binding ResetFilterCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <StackPanel Width="220" Margin="0,0,10,0">
                            <TextBlock Text="Instrument (fehlende Noten)" />
                            <ComboBox ItemsSource="{Binding FilterInstrumentOptions}"
                                      SelectedItem="{Binding SelectedFilterInstrument}"
                                      DisplayMemberPath="Name" />
                        </StackPanel>
                        <CheckBox Content="Nur Stücke mit fehlenden Noten für dieses Instrument"
                                  IsChecked="{Binding MissingScoresForInstrumentFilter}"
                                  VerticalAlignment="Bottom" Margin="0,0,10,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Eigenständige Ergebnisliste der Filter-Seite -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="⚙ Spalten konfigurieren …" Padding="10,4" Click="OpenFilterColumnConfig_Click"/>
                            <Separator Margin="8,0" Width="1" Background="#DDDDDD"/>
                            <Button Content="🖨 Filterliste drucken …" Padding="10,4" Margin="8,0,0,0" Click="PrintFilterListButton_Click"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="FilterResultsGrid"
                              ItemsSource="{Binding FilteredPieces}" SelectedItem="{Binding SelectedFilteredPiece}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              MouseDoubleClick="FilterResultsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="FilterColName" Header="Name" Binding="{Binding Title}" Width="*" MinWidth="120"/>
                            <DataGridTextColumn x:Name="FilterColComposer" Header="Komponist" Binding="{Binding Composer}" Width="*" MinWidth="80"/>
                            <DataGridTextColumn x:Name="FilterColArranger" Header="Arrangeur" Binding="{Binding Arranger}" Width="*" MinWidth="80"/>
                            <DataGridTextColumn x:Name="FilterColGenre" Header="Gattung" Binding="{Binding Genre}" Width="*" MinWidth="80"/>
                            <DataGridTextColumn x:Name="FilterColTags" Header="Tags" Binding="{Binding Tags}" Width="*" MinWidth="80"/>
                            <DataGridCheckBoxColumn x:Name="FilterColIsActive" Header="Aktiv" Binding="{Binding IsActive}" Width="55"/>
                            <DataGridTemplateColumn x:Name="FilterColCabinet" Header="Schrank" Width="80" SortMemberPath="Cabinet" CanUserSort="True" CellTemplate="{StaticResource CabinetCellTemplate}" />
                            <DataGridTextColumn x:Name="FilterColCompartment" Header="Fach" Binding="{Binding Compartment}" Width="60"/>
                            <DataGridTextColumn x:Name="FilterColSlot" Header="Einschub" Binding="{Binding Slot}" Width="70"/>
                            <DataGridTextColumn x:Name="FilterColDigitalScores" Header="Noten" Binding="{Binding DigitalScoreCount}" Width="55"/>
                            <DataGridTextColumn x:Name="FilterColBesetzung" Header="Besetzung" Binding="{Binding Besetzung}" Width="*" MinWidth="80" Visibility="Collapsed"/>
                            <DataGridTextColumn x:Name="FilterColPublisher" Header="Verlag" Binding="{Binding Publisher}" Width="*" MinWidth="80" Visibility="Collapsed"/>
                            <DataGridTextColumn x:Name="FilterColIsbn" Header="ISBN" Binding="{Binding Isbn}" Width="110" Visibility="Collapsed"/>
                            <DataGridTextColumn x:Name="FilterColFolderPath" Header="Ordnerpfad" Binding="{Binding FolderPath}" Width="*" MinWidth="80" Visibility="Collapsed"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Content="Aus Liste laden" Width="130" Margin="0,0,10,0" Command="{Binding LoadFromFilterSelectionCommand}"/>
                        <Button Content="Stück löschen" Width="130" Command="{Binding DeleteFromFilterCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>

        <!-- Label-Druck -->
        <TabItem Header="Label-Druck">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Stücke filtern und für den Label-Druck auswählen" FontWeight="Bold" Margin="0,0,0,8" />

                    <UniformGrid Rows="2" Columns="3" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Name" />
                            <DockPanel>
                                <ComboBox Style="{StaticResource OperatorComboBoxStyle}" DockPanel.Dock="Left"
                                          ItemsSource="{Binding FilterOperatorOptions}" SelectedItem="{Binding TitleFilterOperator}" />
                                <TextBox Text="{Binding TitleFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Komponist" />
                            <DockPanel>
                                <ComboBox Style="{StaticResource OperatorComboBoxStyle}" DockPanel.Dock="Left"
                                          ItemsSource="{Binding FilterOperatorOptions}" SelectedItem="{Binding ComposerFilterOperator}" />
                                <TextBox Text="{Binding ComposerFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Arrangeur" />
                            <DockPanel>
                                <ComboBox Style="{StaticResource OperatorComboBoxStyle}" DockPanel.Dock="Left"
                                          ItemsSource="{Binding FilterOperatorOptions}" SelectedItem="{Binding ArrangerFilterOperator}" />
                                <TextBox Text="{Binding ArrangerFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Verlag" />
                            <DockPanel>
                                <ComboBox Style="{StaticResource OperatorComboBoxStyle}" DockPanel.Dock="Left"
                                          ItemsSource="{Binding FilterOperatorOptions}" SelectedItem="{Binding PublisherFilterOperator}" />
                                <TextBox Text="{Binding PublisherFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="ISBN" />
                            <DockPanel>
                                <ComboBox Style="{StaticResource OperatorComboBoxStyle}" DockPanel.Dock="Left"
                                          ItemsSource="{Binding FilterOperatorOptions}" SelectedItem="{Binding IsbnFilterOperator}" />
                                <TextBox Text="{Binding IsbnFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Tags" />
                            <DockPanel>
                                <ComboBox Style="{StaticResource OperatorComboBoxStyle}" DockPanel.Dock="Left"
                                          ItemsSource="{Binding FilterOperatorOptions}" SelectedItem="{Binding TagsFilterOperator}" />
                                <TextBox Text="{Binding TagsFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <StackPanel Width="120" Margin="0,0,10,0">
                            <TextBlock Text="Schrank" />
                            <ComboBox ItemsSource="{Binding CabinetFilterOptions}" SelectedItem="{Binding CabinetFilter}" />
                        </StackPanel>
                        <StackPanel Width="120" Margin="0,0,10,0">
                            <TextBlock Text="Fach" />
                            <ComboBox ItemsSource="{Binding CompartmentFilterOptions}" SelectedItem="{Binding CompartmentFilter}" />
                        </StackPanel>
                        <StackPanel Width="120" Margin="0,0,10,0">
                            <TextBlock Text="Einschub" />
                            <ComboBox ItemsSource="{Binding SlotFilterOptions}" SelectedItem="{Binding SlotFilter}" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,10,0">
                            <TextBlock Text="Musikgattung" />
                            <ListBox x:Name="LabelGenreFilterListBox"
                                     ItemsSource="{Binding AvailableGenres}"
                                     SelectionMode="Multiple"
                                     Height="80" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                            <CheckBox Content="Nur aktive" IsChecked="{Binding OnlyActiveFilter}" Margin="0,0,10,0" />
                            <CheckBox Content="Nur mit digitalen Noten" IsChecked="{Binding OnlyWithDigitalScoresFilter}" Margin="0,0,10,0" />
                            <Button Content="Filtern" Width="80" Click="LabelFilterButton_Click" Margin="0,0,8,0" />
                            <Button Content="Zurücksetzen" Width="100" Click="LabelResetFilterButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid Grid.Column="0" x:Name="LabelPrintGrid"
                              ItemsSource="{Binding LabelPrintRows}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                              PreviewMouseLeftButtonDown="LabelPrintGrid_PreviewMouseLeftButtonDown">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Drucken" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Piece.Title}" Width="*" MinWidth="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Komponist" Binding="{Binding Piece.Composer}" Width="*" MinWidth="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Arrangeur" Binding="{Binding Piece.Arranger}" Width="*" MinWidth="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Schrank" Binding="{Binding Piece.Cabinet}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Fach" Binding="{Binding Piece.Compartment}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Einschub" Binding="{Binding Piece.Slot}" Width="70" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock x:Name="LabelSelectedCountText"
                                   DockPanel.Dock="Top"
                                   Text="Ausgewählt für Druck (0)"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6"/>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Doppelklick entfernt ein Stück aus der Auswahl."
                                   Foreground="#888888"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"/>
                        <Button DockPanel.Dock="Bottom"
                                Content="Auswahl leeren"
                                Margin="0,6,0,0"
                                Click="LabelClearSelectionButton_Click"/>
                        <ListBox x:Name="LabelSelectedList"
                                 ItemsSource="{Binding LabelSelectedRows}"
                                 MouseDoubleClick="LabelSelectedList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Piece.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="#666666" FontSize="11" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Piece.Composer, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Piece.Cabinet, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,12,0">
                        <Run Text="Label-Format:" FontWeight="SemiBold"/>
                        <Run Text="60 × 21 mm · Schrankfarbe · QR"/>
                    </TextBlock>
                    <Button Content="Alle in Filter" Width="110" Margin="0,0,8,0" Click="LabelSelectAllButton_Click"
                            ToolTip="Alle sichtbaren Treffer zur Druckauswahl hinzufügen"/>
                    <Button Content="Keine in Filter" Width="120" Margin="0,0,8,0" Click="LabelSelectNoneButton_Click"
                            ToolTip="Alle sichtbaren Treffer aus der Druckauswahl entfernen"/>
                    <Button Content="Labels drucken" Width="130" Click="PrintSelectedLabelsButton_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- Einstellungen-Reiter -->
        <TabItem Header="Einstellungen">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <!-- Sprache / Language -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Sprache / Language:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" />
                        <ComboBox Width="140"
                                  ItemsSource="{x:Static loc:AppResources.AvailableLanguages}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding AppLanguage}" />
                    </StackPanel>

                    <GroupBox Header="Aktualisierung" Margin="0,0,0,16">
                        <StackPanel Margin="8">
                            <TextBlock x:Name="AppVersionText" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,8"/>
                            <ProgressBar x:Name="UpdateProgressBar"
                                         Height="14"
                                         Minimum="0"
                                         Maximum="100"
                                         Visibility="Collapsed"
                                         Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckUpdatesButton"
                                        Content="Nach Updates suchen"
                                        Width="160"
                                        Margin="0,0,8,0"
                                        Click="CheckUpdatesButton_Click"/>
                                <Button x:Name="InstallUpdateButton"
                                        Content="Aktualisieren"
                                        Width="120"
                                        IsEnabled="False"
                                        Click="InstallUpdateButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Export / Import -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="⬆ Einstellungen exportieren" Width="200" Margin="0,0,8,0" Click="ExportSettingsButton_Click" />
                        <Button Content="⬇ Einstellungen importieren" Width="200" Click="ImportSettingsButton_Click" />
                    </StackPanel>

                    <!-- Label-Druck -->
                    <GroupBox Header="Label-Druck" Margin="0,0,0,16">
                        <StackPanel Margin="8">
                            <CheckBox x:Name="LabelQrCodeEnabledCheckBox"
                                      Content="QR-Code auf Labels drucken"
                                      Margin="0,0,0,4"
                                      Checked="LabelQrCodeEnabledCheckBox_Changed"
                                      Unchecked="LabelQrCodeEnabledCheckBox_Changed"/>
                            <TextBlock Text="Deaktiviert: Komponist und Arrangeur nutzen die volle Labelbreite (ohne QR-Feld)."
                                       Foreground="#888888"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Admin -->
                    <GroupBox Header="Administration" Margin="0,0,0,16" Visibility="Visible">
                        <StackPanel Margin="8">
                            <StackPanel Visibility="{Binding AdminLoginVisibility}">
                                <TextBlock Text="Admin-Anmeldung" FontWeight="Bold" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <PasswordBox x:Name="AdminPasswordBox" Width="160" Margin="0,0,8,0" KeyDown="AdminPasswordBox_KeyDown" />
                                    <Button Content="Anmelden" Width="90" Click="AdminLoginButton_Click" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Visibility="{Binding AdminActionsVisibility}">
                                <TextBlock Text="Angemeldet als Administrator" FontWeight="Bold" Foreground="DarkGreen" Margin="0,0,0,8" />
                                <Border Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Aktuelle Zugangsdaten" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="AdminWebPasswordText" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="AdminApiKeyText" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Duplikate bereinigen"
                                            Width="170"
                                            Margin="0,0,8,0"
                                            Click="DuplicateCleanupButton_Click"/>
                                    <Button Content="Alle Musikstücke löschen"
                                            Width="200"
                                            Margin="0,0,8,0"
                                            Foreground="DarkRed"
                                            Command="{Binding DeleteAllPiecesCommand}" />
                                    <Button Content="Abmelden" Width="90" Click="AdminLogoutButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Synchronisation -->
                    <GroupBox Header="Synchronisation" Margin="0,0,0,16">
                        <StackPanel Margin="8">
                            <StackPanel Visibility="{Binding AdminActionsVisibility}">
                                <TextBlock Text="Server-URL" Margin="0,0,0,4"/>
                                <TextBox x:Name="SyncServerUrlTextBox" Margin="0,0,0,8"/>

                                <TextBlock Text="Web-App Passwort (Ansicht)" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="SyncWebPasswordBox" Margin="0,0,0,4"/>
                                <TextBlock Text="Standard: admin · wird beim Hochladen an den Server übertragen." Foreground="#888888" FontSize="11" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Content="Konfiguration speichern" Width="150" Margin="0,0,8,0" Click="SyncSaveConfig_Click"/>
                                    <Button Content="Verbindung testen" Width="130" Click="SyncTestConnection_Click"/>
                                </StackPanel>

                                <StackPanel x:Name="SyncAdvancedSettingsPanel" Visibility="Collapsed">
                                    <TextBlock Text="API-Schlüssel (optional)" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="SyncApiKeyBox" Margin="0,0,0,8"/>

                                    <TextBlock Text="Sync-Warnung anzeigen nach (Tagen)" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SyncWarningDaysTextBox" Width="80" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <TextBlock Text="0 = Warnbanner deaktivieren" Foreground="#888888" FontSize="11" Margin="0,0,0,8"/>

                                    <TextBlock x:Name="LastLocalChangeText" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="SyncStatusText" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="SyncActivityText" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <ProgressBar x:Name="SyncProgressBar"
                                         Height="14"
                                         Minimum="0"
                                         Maximum="100"
                                         Visibility="Collapsed"
                                         Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SyncPushButton" Content="⬆ Zum Server hochladen" Width="160" Margin="0,0,8,0" Click="SyncPush_Click"/>
                                <Button x:Name="SyncPullButton" Content="⬇ Vom Server laden" Width="160" Margin="0,0,8,0" Click="SyncPull_Click"/>
                                <Button x:Name="SyncStopUploadButton" Content="Stopp Upload" Width="120" Visibility="Collapsed" Click="SyncStopUpload_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Zeile 1: Tags + Musikgattungen -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="Tags" Grid.Column="0" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="Neuen Tag hinzufügen" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox x:Name="NewTagTextBox" Width="160" Margin="0,0,8,0" />
                                    <Button Content="Hinzufügen" Width="90" Click="AddTagButton_Click" />
                                </StackPanel>
                                <TextBlock Text="Vorhandene Tags" Margin="0,0,0,4" />
                                <ListBox x:Name="TagsSettingsListBox" ItemsSource="{Binding AvailableTags}" Height="120" />
                                <Button Content="Ausgewählten Tag löschen" Margin="0,4,0,0" Width="180" HorizontalAlignment="Left" Click="RemoveTagButton_Click" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Musikgattungen" Grid.Column="1" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Neue Musikgattung hinzufügen" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox x:Name="NewGenreTextBox" Width="160" Margin="0,0,8,0" />
                                    <Button Content="Hinzufügen" Width="90" Click="AddGenreButton_Click" />
                                </StackPanel>
                                <TextBlock Text="Vorhandene Musikgattungen" Margin="0,0,0,4" />
                                <ListBox x:Name="GenresSettingsListBox" ItemsSource="{Binding AvailableGenres}" Height="120" />
                                <Button Content="Ausgewählte Musikgattung löschen" Margin="0,4,0,0" Width="220" HorizontalAlignment="Left" Click="RemoveGenreButton_Click" />
                            </StackPanel>
                        </GroupBox>
                    </Grid>

                    <!-- Zeile 2: Schrank + Fach + Einschub -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="Schrank" Grid.Column="0" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="Neuen Schrank hinzufügen" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBox x:Name="NewCabinetTextBox" Width="70" Margin="0,0,6,0" />
                                    <TextBlock Text="Farbe:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Text="{Binding NewCabinetColor, UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="0,0,4,0" />
                                    <Border Width="20" Height="20" Background="{Binding NewCabinetColorBrush}" BorderBrush="Gray" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <Button Content="+" Width="26" Click="AddCabinetButton_Click" />
                                </StackPanel>
                                <ListBox x:Name="CabinetSettingsListBox"
                                         ItemsSource="{Binding AvailableCabinets}"
                                         SelectedItem="{Binding SelectedCabinetSetting, Mode=TwoWay}"
                                         Height="100" Margin="0,0,0,4">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" Background="{Binding DisplayBrush}" BorderBrush="Gray" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Farbe ändern:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="10" />
                                    <TextBox Text="{Binding EditCabinetColor, UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="0,0,4,0" />
                                    <Border Width="20" Height="20" Background="{Binding EditCabinetColorBrush}" BorderBrush="Gray" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <Button Content="Speichern" Padding="6,2" Click="UpdateCabinetColorButton_Click" />
                                </StackPanel>
                                <Button Content="Eintrag löschen" Width="120" HorizontalAlignment="Left" Click="RemoveCabinetButton_Click" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Fach" Grid.Column="1" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="Neues Fach hinzufügen" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox x:Name="NewCompartmentTextBox" Width="100" Margin="0,0,8,0" />
                                    <Button Content="Hinzufügen" Width="80" Click="AddCompartmentButton_Click" />
                                </StackPanel>
                                <ListBox x:Name="CompartmentSettingsListBox" ItemsSource="{Binding AvailableCompartments}" Height="120" />
                                <Button Content="Eintrag löschen" Margin="0,4,0,0" Width="120" HorizontalAlignment="Left" Click="RemoveCompartmentButton_Click" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Einschub" Grid.Column="2" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Neuen Einschub hinzufügen" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox x:Name="NewSlotTextBox" Width="100" Margin="0,0,8,0" />
                                    <Button Content="Hinzufügen" Width="80" Click="AddSlotButton_Click" />
                                </StackPanel>
                                <ListBox x:Name="SlotSettingsListBox" ItemsSource="{Binding AvailableSlots}" Height="120" />
                                <Button Content="Eintrag löschen" Margin="0,4,0,0" Width="120" HorizontalAlignment="Left" Click="RemoveSlotButton_Click" />
                            </StackPanel>
                        </GroupBox>
                    </Grid>

                    <!-- Zeile 3: Besetzungsgruppen -->
                    <TextBlock Text="Instrumente &amp; Besetzungsgruppen" FontWeight="Bold" FontSize="13" Margin="0,12,0,6" />

                    <!-- Neues Instrument anlegen -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Neues Instrument:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="NewInstrumentTextBox" Width="180" Margin="0,0,8,0" />
                        <Button Content="Anlegen" Width="80" Click="AddInstrumentButton_Click" />
                    </StackPanel>

                    <!-- 5-spaltig: Nicht zugewiesen | Gruppe 1 | Gruppe 2 | Gruppe 3 | Gruppe 4 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Nicht zugewiesen + Zuweisen-Steuerung -->
                        <GroupBox Header="Nicht zugewiesen" Grid.Column="0" Margin="0,0,4,0">
                            <StackPanel>
                                <ListBox x:Name="UnassignedListBox" ItemsSource="{Binding UnassignedInstrumentNames}" Height="130" />
                                <TextBlock Text="Auswahl zuweisen zu:" Margin="0,6,0,2" FontSize="10" />
                                <ComboBox x:Name="AssignGroupComboBox" Margin="0,0,0,6">
                                    <ComboBoxItem Content="1 – Partitur / Direktion" Tag="1" />
                                    <ComboBoxItem Content="2 – Holz" Tag="2" />
                                    <ComboBoxItem Content="3 – Schlagwerk" Tag="3" />
                                    <ComboBoxItem Content="4 – Blechbläser / Gesang" Tag="4" />
                                </ComboBox>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Zuweisen ▶" Padding="8,3" Margin="0,0,6,0" Click="AssignInstrumentButton_Click" />
                                    <Button Content="Löschen" Padding="8,3" Foreground="DarkRed" Click="DeleteUnassignedButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Gruppe 1: Partitur / Direktion -->
                        <GroupBox Header="Partitur / Direktion" Grid.Column="1" Margin="4,0,4,0">
                            <StackPanel>
                                <ListBox x:Name="Group1MembersListBox" ItemsSource="{Binding Group1InstrumentNames}" Height="130" />
                                <Button Content="◀ Entfernen" HorizontalAlignment="Left" Padding="6,2" Margin="0,6,0,0" Click="RemoveFromGroup1_Click" />
                            </StackPanel>
                        </GroupBox>

                        <!-- Gruppe 2: Holz -->
                        <GroupBox Header="Holz" Grid.Column="2" Margin="4,0,4,0">
                            <StackPanel>
                                <ListBox x:Name="Group2MembersListBox" ItemsSource="{Binding Group2InstrumentNames}" Height="130" />
                                <Button Content="◀ Entfernen" HorizontalAlignment="Left" Padding="6,2" Margin="0,6,0,0" Click="RemoveFromGroup2_Click" />
                            </StackPanel>
                        </GroupBox>

                        <!-- Gruppe 3: Schlagwerk -->
                        <GroupBox Header="Schlagwerk" Grid.Column="3" Margin="4,0,4,0">
                            <StackPanel>
                                <ListBox x:Name="Group3MembersListBox" ItemsSource="{Binding Group3InstrumentNames}" Height="130" />
                                <Button Content="◀ Entfernen" HorizontalAlignment="Left" Padding="6,2" Margin="0,6,0,0" Click="RemoveFromGroup3_Click" />
                            </StackPanel>
                        </GroupBox>

                        <!-- Gruppe 4: Blechbläser / Gesang -->
                        <GroupBox Header="Blechbläser / Gesang" Grid.Column="4" Margin="4,0,0,0">
                            <StackPanel>
                                <ListBox x:Name="Group4MembersListBox" ItemsSource="{Binding Group4InstrumentNames}" Height="130" />
                                <Button Content="◀ Entfernen" HorizontalAlignment="Left" Padding="6,2" Margin="0,6,0,0" Click="RemoveFromGroup4_Click" />
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
    </DockPanel>
