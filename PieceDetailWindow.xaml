<Window x:Class="MusikArchivApp.PieceDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MusikArchivApp.Converters"
        Title="Musikstück – Details"
        Width="860" MinWidth="820" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="Assets/app.ico">
    <Window.Resources>
        <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
        <conv:HexColorToForegroundBrushConverter x:Key="HexColorToForegroundBrushConverter" />
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Margin" Value="0,0,18,8"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="EditBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,8">

                <!-- Ansicht -->
                <StackPanel x:Name="ViewPanel">
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Separator Margin="0,0,0,10"/>

                    <TextBlock Text="ALLGEMEIN" Style="{StaticResource SectionHeader}"/>
                    <Separator Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Komponist" Style="{StaticResource Lbl}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Composer}" Style="{StaticResource Val}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Arrangeur" Style="{StaticResource Lbl}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Arranger}" Style="{StaticResource Val}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Verlag" Style="{StaticResource Lbl}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Publisher}" Style="{StaticResource Val}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ISBN" Style="{StaticResource Lbl}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Isbn}" Style="{StaticResource Val}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Gattung" Style="{StaticResource Lbl}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Genre}" Style="{StaticResource Val}"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Tags" Style="{StaticResource Lbl}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Tags}" Style="{StaticResource Val}"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Im Probelokal" Style="{StaticResource Lbl}"/>
                        <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding IsActive}" IsEnabled="False" VerticalAlignment="Center" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Ordnerpfad" Style="{StaticResource Lbl}"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding FolderPath}" Style="{StaticResource Val}"/>
                    </Grid>

                    <TextBlock Text="STANDORT" Style="{StaticResource SectionHeader}"/>
                    <Separator Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Schrank" Style="{StaticResource Lbl}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <Border MinWidth="28" Padding="8,2"
                                    Background="{Binding CabinetColor, Converter={StaticResource HexColorToBrushConverter}}"
                                    BorderBrush="Gray" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Cabinet}"
                                           Foreground="{Binding CabinetColor, Converter={StaticResource HexColorToForegroundBrushConverter}}"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Fach" Style="{StaticResource Lbl}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Compartment}" Style="{StaticResource Val}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Einschub" Style="{StaticResource Lbl}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Slot}" Style="{StaticResource Val}"/>
                    </Grid>
                </StackPanel>

                <!-- Inline-Bearbeitung -->
                <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                    <TextBlock Text="Titel" Style="{StaticResource Lbl}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditBox}" FontSize="16" FontWeight="Bold"/>
                    <Separator Margin="0,0,0,10"/>

                    <TextBlock Text="ALLGEMEIN" Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Komponist" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Composer}" Style="{StaticResource EditBox}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Arrangeur" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Arranger}" Style="{StaticResource EditBox}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Verlag" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Publisher}" Style="{StaticResource EditBox}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ISBN" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Isbn}" Style="{StaticResource EditBox}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Gattung" Style="{StaticResource Lbl}"/>
                        <ListBox Grid.Row="4" Grid.Column="1" x:Name="GenresEditListBox" SelectionMode="Multiple" Height="72" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Tags" Style="{StaticResource Lbl}"/>
                        <ListBox Grid.Row="5" Grid.Column="1" x:Name="TagsEditListBox" SelectionMode="Multiple" Height="72" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Im Probelokal" Style="{StaticResource Lbl}"/>
                        <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding IsActive}" VerticalAlignment="Center" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Ordnerpfad" Style="{StaticResource Lbl}"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding FolderPath}" Style="{StaticResource EditBox}"/>
                    </Grid>

                    <TextBlock Text="STANDORT" Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Schrank" Style="{StaticResource Lbl}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CabinetEditComboBox"
                                  SelectedValuePath="Name"
                                  SelectedValue="{Binding Cabinet, Mode=TwoWay}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Fach" Style="{StaticResource Lbl}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CompartmentEditComboBox"
                                  SelectedItem="{Binding Compartment, Mode=TwoWay}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Einschub" Style="{StaticResource Lbl}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="SlotEditComboBox"
                                  SelectedItem="{Binding Slot, Mode=TwoWay}" Margin="0,0,0,8"/>
                    </Grid>

                    <TextBlock Text="BESETZUNG" Style="{StaticResource SectionHeader}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Partitur / Direktion" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="InstrumentsEditGroup1">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Instrument.Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Holz" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="InstrumentsEditGroup2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Instrument.Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Schlagwerk" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="InstrumentsEditGroup3">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Instrument.Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Blechbläser / Gesang" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="InstrumentsEditGroup4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Instrument.Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Besetzung (nur Ansicht) -->
                <StackPanel x:Name="BesetzungViewPanel">
                <TextBlock Text="BESETZUNG" Style="{StaticResource SectionHeader}"/>
                <Separator Margin="0,0,0,10"/>
                <Grid x:Name="BesetzungGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Partitur / Direktion" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="Group1List">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Holz" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                        <ItemsControl x:Name="Group2List">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Schlagwerk" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                        <ItemsControl x:Name="Group3List">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Blechbläser / Gesang" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="Group4List">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="24,8,24,16">
            <WrapPanel x:Name="ViewButtonsPanel" HorizontalAlignment="Right">
                <Button Content="Im Web anzeigen" MinWidth="130" Margin="0,0,8,8" Click="OpenWebViewButton_Click"/>
                <Button Content="Digitale Noten …" MinWidth="130" Margin="0,0,8,8" Click="OpenSheetMusicButton_Click"/>
                <Button Content="Schnellbearbeitung" MinWidth="140" Margin="0,0,8,8" Click="InlineEditButton_Click"/>
                <Button Content="Im Editor öffnen" MinWidth="130" Margin="0,0,8,8" Click="OpenInEditorButton_Click"/>
                <Button Content="Label drucken" MinWidth="120" Margin="0,0,8,8" Click="PrintLabelButton_Click"/>
                <Button x:Name="DeleteButton" Content="Stück löschen" MinWidth="110" Margin="0,0,8,8" Foreground="DarkRed" Click="DeleteButton_Click"/>
                <Button Content="Schließen" MinWidth="100" Margin="0,0,0,8" Click="CloseButton_Click"/>
            </WrapPanel>
            <StackPanel x:Name="EditButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                <Button x:Name="SaveEditButton" Content="Speichern" Width="110" Margin="0,0,8,0" Click="SaveEditButton_Click"/>
                <Button Content="Abbrechen" Width="110" Click="CancelEditButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
