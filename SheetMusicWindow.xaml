<Window x:Class="MusikArchivApp.SheetMusicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Digitale Noten"
        Width="980" Height="720"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="PathText" Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="Dateien per Drag &amp; Drop hierher ziehen" Foreground="#888888" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="Notendateien" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Hinzufügen …" Width="100" Margin="0,0,8,0" Click="AddFileButton_Click"/>
                    <Button Content="Entfernen" Width="90" Click="RemoveFileButton_Click"/>
                </StackPanel>
            </StackPanel>

            <ListBox x:Name="FilesListBox" DisplayMemberPath="FileName" SelectionChanged="FilesListBox_SelectionChanged"/>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="Zuweisung" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="AssignmentComboBox" DisplayMemberPath="Label" Margin="0,0,0,8"/>
                <Button Content="Zuweisung speichern" Click="SaveAssignmentButton_Click"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="1" MinHeight="300">
            <Grid>
                <wv2:WebView2 x:Name="PdfPreview" Visibility="Collapsed"/>
                <ScrollViewer x:Name="ImageScrollViewer" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                </ScrollViewer>
                <TextBlock x:Name="PreviewPlaceholder"
                           Text="Datei auswählen oder per Drag &amp; Drop hinzufügen."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#888888"
                           TextWrapping="Wrap"
                           Margin="16"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Datenordner öffnen" Width="130" Margin="0,0,8,0" Click="OpenFolderButton_Click"/>
            <Button Content="Drucken" Width="90" Margin="0,0,8,0" Click="PrintButton_Click"/>
            <Button Content="Schließen" Width="90" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
